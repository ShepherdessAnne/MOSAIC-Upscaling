{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Generative Section Upscaling Job Plan",
  "type": "object",
  "required": [
    "artifact_kind",
    "protocol",
    "protocol_version",
    "binding_status",
    "intent",
    "source",
    "target",
    "sections",
    "corrections"
  ],
  "properties": {
    "artifact_kind": {
      "const": "job_plan"
    },
    "protocol": {
      "const": "generative_section_upscaling"
    },
    "protocol_version": {
      "const": "1.1"
    },
    "binding_status": {
      "enum": [
        "unbound",
        "bound"
      ]
    },
    "intent": {
      "enum": [
        "upscale_only",
        "upscale_with_corrections"
      ]
    },
    "source": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "target": {
      "type": "object",
      "required": [
        "scale"
      ],
      "properties": {
        "scale": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "protected_rects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rect"
      }
    },
    "atlas_background": {
      "type": "string"
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "corrections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "instruction",
          "section_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "instruction": {
            "type": "string",
            "minLength": 1
          },
          "section_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "binding_status": {
            "const": "bound"
          }
        }
      },
      "then": {
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "sections": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "intent": {
            "const": "upscale_only"
          }
        }
      },
      "then": {
        "properties": {
          "corrections": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "corrections": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "rect": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "integer",
          "minimum": 0
        }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "section": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "box": {
          "$ref": "#/$defs/rect"
        },
        "cells": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "box"
            ],
            "properties": {
              "box": {
                "$ref": "#/$defs/rect"
              },
              "name": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "columns": {
          "type": "integer",
          "minimum": 1
        },
        "cell_size": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 9
          }
        },
        "invariants": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "align": {
          "type": "boolean"
        },
        "feather": {
          "type": "number",
          "minimum": 0
        },
        "max_shift": {
          "type": "number",
          "minimum": 0
        },
        "color_match": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "oneOf": [
        {
          "required": [
            "box"
          ],
          "not": {
            "required": [
              "cells"
            ]
          }
        },
        {
          "required": [
            "cells"
          ],
          "not": {
            "required": [
              "box"
            ]
          }
        }
      ],
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}

